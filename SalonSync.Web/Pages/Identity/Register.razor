@page "/register"
@layout HeadlessLayout
@using SalonSync.Web.Components.Fields
@inherits RegisterPage

<PageTitle>Salon Sync - Cadastrar</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" md="8" lg="6" xl="6" xxl="6">
        <MudPaper Class="mud-width-full pa-8">
            <div class="d-flex justify-center pb-8 pt-8">
                <img src="Uploads/LogoRedondaSemFundo.png"
                     alt="Salon Sync - Gestão de Salão"
                     width="200" />
            </div>

            <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator />
                <MudTextField T="string"
                              Label="E-mail *"
                              HelperText="Campo obrigatório"
                              InputType="InputType.Email"
                              For="@(() => InputModel.RegisterRequest.Email)"
                              @bind-Value="InputModel.RegisterRequest.Email"
                              Variant="Variant.Outlined"
                              />
                
                <PasswordMudTextField Label="Senha *"
                                      HelperText="Campo obrigatório"
                                      For="@(() => InputModel.RegisterRequest.Password)"
                                      @bind-Value="InputModel.RegisterRequest.Password" />

                <MudTextField T="string" 
                              Label="Nome *"
                              InputType="InputType.Text"
                              HelperText="Campo obrigatório"
                              For="@(() => InputModel.CompanyRequest.Name)"
                              @bind-Value="InputModel.CompanyRequest.Name"
                              Variant="Variant.Outlined"/>
                
                <DocumentMudTextField
                    @bind-Value="InputModel.CompanyRequest.Document"/>
                
                <PhoneMudTextField 
                    @bind-Value="InputModel.CompanyRequest.Phone" />
                
                <div Class="d-flex mt-8">
                    @if (IsBusy)
                    {
                        <MudProgressCircular Color="Color.Info" Indeterminate="true" />
                    }
                    else
                    {
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Cadastrar</MudButton>
                        <MudSpacer />
                        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">Já tenho uma conta</MudButton>
                    }
                </div>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

