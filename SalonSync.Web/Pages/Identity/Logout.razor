@page "/logout"
@inherits LogoutPage
@layout HeadlessLayout

<PageTitle>Salon Sync - Sair</PageTitle>

<MudText Typo="Typo.h3">Finalizando a sessão...</MudText>
<MudPaper Class="pa-8 mt-4">
    <div class="d-flex justify-center pb-8 pt-8">
        <img src="Uploads/LogoRedondaSemFundo.png"
             alt="Salon Sync - Gestão de Salão"
             width="200" />
    </div>
    <MudAlert Severity="Severity.Info">
        <div>
            Sessão Finalizada
            <MudButton Variant="Variant.Text" Href="/login">
                IR PARA TELA DE LOGIN
            </MudButton>
        </div>
    </MudAlert>
</MudPaper>
