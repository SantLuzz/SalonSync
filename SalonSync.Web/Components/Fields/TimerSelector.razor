@using SalonSync.Core.DTOs
<MudCollapse Expanded="@DateIsSelected">
    <MudText Typo="Typo.h6">Selecione o Horário:</MudText>
    @if (AvailabilitySlotsDto.Hours.Count > 0)
    {
        <div id="hourContainer" class="scroll-container mt-10" 
             @onpointerdown="@StartSwipe"
             @onpointermove="@OnSwipe"
             @onpointerup="EndSwipe">
            <div class="scroll-content">
                @foreach (var slots in AvailabilitySlotsDto.Hours)
                {
                    <SelectableCard T="Hours"
                                    Icon="@Icons.Material.Filled.AccessTime"
                                    CardValue="slots"
                                    CardText="Horários:"
                                    CardValueText="@($"{slots.StartTime.ToString("HH:mm")} - {slots.EndTime.ToString("HH:mm")}")"
                                    OnValueSelected="HandleHourSelection"
                                    SelectableStyle="@GetCardClass(slots)"/>
                }
            </div>
        </div>
    }
    else
    {
        <MudText class="mt-10" Typo="Typo.h6">Não existem horário disponíveis para esse profissional!</MudText>
        <MudText class="mt-4" Typo="Typo.h6">@(AvailabilitySlotsDto.NextAvaliabeDate.HasValue 
                                                 ? $"Próxima data disponível: {AvailabilitySlotsDto.NextAvaliabeDate.Value:dd/MM/yyyy}" 
                                                 : "")</MudText>
    }
                
</MudCollapse>

<style>
    .scroll-container {
        overflow-x: auto; /* Ativa a rolagem horizontal */
        white-space: nowrap; /* Impede que os itens quebrem a linha */
        padding: 10px;
        scroll-behavior: smooth; /* Faz a rolagem ser suave */
        -webkit-overflow-scrolling: touch; /* Suaviza rolagem no iOS */
    }

    .scroll-content {
        display: flex; /* Garante que os itens fiquem lado a lado */
        gap: 10px; /* Espaçamento entre os cards */
    }

    .scroll-container::-webkit-scrollbar {
        display: none; /* Oculta a barra de rolagem */
    }

    .selected-card {
        background-color: #5EAEE1;
        color: white;
        border: 2px solid #073b5d;
    }
    
</style>

@code{

    [Parameter] public EmployeeAvailabilitySlotsDTO AvailabilitySlotsDto { get; set; } = new();
    [Parameter] public EventCallback<Hours> OnHourSelected { get; set; }
    [Parameter] public bool DateIsSelected { get; set; } = false;

    [Inject] public IJSRuntime JsRuntime { get; set; } = null!;
    
    private double startX;
    private ElementReference scrollContainer;
    private Hours? SelectedHour { get; set; } 
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JsRuntime.InvokeVoidAsync("enableSwipeScroll", "hourContainer");
    }

    protected override Task OnParametersSetAsync()
    {
        if (!DateIsSelected)
            SelectedHour = null;
        return base.OnParametersSetAsync();
    }

    private async Task HandleHourSelection(Hours selectedHour)
    {
        SelectedHour = selectedHour;
        await OnHourSelected.InvokeAsync(selectedHour);
    }
    
    private async Task StartSwipe(PointerEventArgs e)
    {
        startX = e.ClientX;
    }

    private async Task OnSwipe(PointerEventArgs e)
    {
        double deltaX = e.ClientX - startX;

        await JsRuntime.InvokeVoidAsync("scrollHorizontally", "hourContainer", -deltaX);
    
        startX = e.ClientX;
    }

    private async Task EndSwipe(PointerEventArgs e)
    {
        startX = 0;
    }
    
    private string GetCardClass(Hours slots)
    {
        return slots.Equals(SelectedHour) ? "selected-card" : "";
    }
}