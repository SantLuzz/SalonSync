@using System.Linq.Expressions

<MudTextField T="string"
              Label="@Label"
              HelperText="@HelperText"
              InputType="@passwordInputType"
              Variant="Variant.Outlined"
              Adornment="Adornment.End"
              AdornmentIcon="@passwordIcon"
              AdornmentColor="Color.Secondary"
              OnAdornmentClick="TogglePasswordVisibility"
              For="@For"
              Value="@Value"
              ValueChanged="OnValueChanged">
</MudTextField>

@code {
[Parameter] public string Value { get; set; } = string.Empty;
[Parameter] public EventCallback<string> ValueChanged { get; set; } // Para binding bidirecional
[Parameter] public string Label { get; set; } = "Senha";
[Parameter] public string HelperText { get; set; } = "Campo obrigatório";
[Parameter] public Expression<Func<string>>? For { get; set; }

private InputType passwordInputType = InputType.Password;
private string passwordIcon = Icons.Material.Filled.VisibilityOff;

private async Task TogglePasswordVisibility()
{
passwordInputType = passwordInputType == InputType.Password ? InputType.Text : InputType.Password;
passwordIcon = passwordInputType == InputType.Text ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

await ValueChanged.InvokeAsync(Value); // Garante que o binding seja atualizado
}

private async Task OnValueChanged(string newValue)
{
Value = newValue;
await ValueChanged.InvokeAsync(newValue);
}
}
