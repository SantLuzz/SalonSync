@using SalonSync.Core
<div class="d-flex justify-center pb-8 pt-8">
    <img src="uploads/LogoRedondaSemFundo.png"
         alt="Salon Sync - Gestão Financeira"
         width="200" />
</div>

<AuthorizeView>
    <MudNavMenu>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Dashboard</MudNavLink>
        @if (context.User.IsInRole(Configuration.CompanyUserRole) 
             || context.User.IsInRole(Configuration.SuperAdminRole))
        {
            <MudNavGroup Title="Agendamentos" Icon="@Icons.Material.Filled.Schedule" Expanded="true">
                <MudNavLink Href="/open-appointments" Match="NavLinkMatch.All">Abrir Agenda dos Profissionais</MudNavLink>
                <MudNavLink Href="/appointments" Match="NavLinkMatch.All">Agenda</MudNavLink>
                <MudNavLink Href="/in-development" Match="NavLinkMatch.All">Agenda de Senhas</MudNavLink>
            </MudNavGroup>
            
            <MudNavLink Href="/transactions" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.RequestPage" >Caixa</MudNavLink>
            <MudNavLink Href="/cost-centers" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.BusinessCenter" >Centro de Custo</MudNavLink>
            <MudNavLink Href="/clients" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person">Clientes</MudNavLink>
            <MudNavLink Href="/accounts-payable" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalance">Contas a Pagar</MudNavLink>
            <MudNavLink Href="/company" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Business">Empresa Usuária</MudNavLink>
            <MudNavGroup Title="Equipe" Icon="@Icons.Material.Filled.Receipt" Expanded="true">
                <MudNavLink Href="/in-development" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.MonetizationOn">Comissão</MudNavLink>
                <MudNavLink Href="/employees" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ManageAccounts">Gestão de Profissionais</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/packages" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingBag" >Pacotes</MudNavLink>
            <MudNavLink Href="/clients-packages" Icon="@Icons.Material.Filled.ShoppingBag">Pacotes dos Clientes</MudNavLink>
            <MudNavLink Href="/services" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingBag" >Serviços</MudNavLink>
            <MudNavGroup Title="Relatórios" Icon="@Icons.Material.Filled.Receipt" Expanded="false">
                <MudNavLink Href="/in-development" Match="NavLinkMatch.All">Comissão por Profissional</MudNavLink>
                <MudNavLink Href="/in-development" Match="NavLinkMatch.All">Histórico de Cancelamentos</MudNavLink>
                <MudNavLink Href="/in-development" Match="NavLinkMatch.All">Mov. por Centro de Custo</MudNavLink>
                <MudNavLink Href="/in-development" Match="NavLinkMatch.All">Mov. Sintético</MudNavLink>
                <MudNavLink Href="/in-development" Match="NavLinkMatch.All">Mov. Analítico</MudNavLink>
            </MudNavGroup>
            
        }

        @if (context.User.IsInRole(Configuration.SuperAdminRole))
        {
            <MudNavLink Href="/licenses" Icon="@Icons.Material.Filled.AttachMoney">Licenças</MudNavLink>
        }
        <MudNavLink Href="/logout" Icon="@Icons.Material.Filled.Logout">Sair</MudNavLink>
    </MudNavMenu>
</AuthorizeView>
