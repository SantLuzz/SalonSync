@using System.Linq.Expressions
@using SalonSync.Web.Common
<MudTextField T="string"
              Label="@Label"
              HelperText="@FormattedHelperText"
              Variant="Variant.Outlined"
              Immediate="true"
              Value="@RawValue"
              ValueChanged="OnValueChanged"
              MaxLength="18"
              For="@(For is null ? null : For)" />

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "CPF ou CNPJ";
    [Parameter] public Expression<Func<string>>? For { get; set; } 

    private string _rawValue = string.Empty;

    private string RawValue { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        RawValue = Masks.ApplyDocumentMask(Value);
    }
    
    private int MaxDigits => RawValue.Length <= 11 ? 11 : 14;

    private string FormattedHelperText => $"Documento: {GetHelperText(RawValue)}";

    private async Task OnValueChanged(string newValue)
    {
        // Remove qualquer caractere não numérico
        string onlyNumbers = new string(newValue.Where(char.IsDigit).ToArray());

        // Limita o tamanho máximo permitido
        if (onlyNumbers.Length > 14)
            onlyNumbers = onlyNumbers[..14];

        // Formata CPF ou CNPJ automaticamente
        RawValue = Masks.ApplyDocumentMask(onlyNumbers);
        await ValueChanged.InvokeAsync(onlyNumbers);
    }

    private string GetHelperText(string value)
    {
        value = value.ForNumbersOnly();

        return value.Length <= 11 ?
            ApplyMask(value, "XXX.XXX.XXX-XX", 11) :
            ApplyMask(value, "XX.XXX.XXX/XXXX-XX", 14);
    }

    private string ApplyMask(string input, string mask, int maxLength)
    {
        char[] result = mask.ToCharArray();
        int index = 0;

        for (int i = 0; i < result.Length; i++)
        {
            if (mask[i] == 'X' && index < input.Length)
            {
                result[i] = 'X';
                index++;
            }
            else if (mask[i] == 'X')
            {
                result[i] = '-';
            }
        }

        return new string(result);
    }
}
