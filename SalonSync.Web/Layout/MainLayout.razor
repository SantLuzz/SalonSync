@using SalonSync.Web.Components.Identity
@inherits LayoutComponentBase

<MudThemeProvider @ref="_mudThemeProvider"
                  @bind-IsDarkMode="_isDarkMode" 
                  Theme="WebConfiguration.Theme" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar>
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit" 
                               Edge="Edge.Start"
                               OnClick="ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="d-flex align-items-end">
                    <span style="font-size: 1.5rem; font-weight: 600;">Salon Sync</span>
                    <span class="ml-1" style="font-size: 0.75rem; color: gray;">@version</span>
                </MudText>

                <MudSpacer />
                <div class="d-flex align-items-center">
                    <div style="height: 100%; display: flex; align-items: center;" class="mr-2">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Size="Size.Large" />
                    </div>

                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.caption" Class="font-weight-bold">
                            @{
                                var companyName = context.User.FindFirst("CompanyName")?.Value ?? "Empresa não informada";
                                var companyCnpj = context.User.FindFirst("CompanyCnpj")?.Value;
                            }
                            @companyName @(string.IsNullOrWhiteSpace(companyCnpj) ? "" : $" - {companyCnpj}")
                        </MudText>

                        
                        <MudText Typo="Typo.caption" Class="text-secondary" Style="font-size: 0.7rem;">
                            @{
                                string? companyLicense = context.User.FindFirst("CompanyLicense") is not null
                                ? context.User.FindFirst("CompanyLicense")?.Value
                                : "Não expira.";
                            }
                            Expira em: @companyLicense
                        </MudText>
                    </div>

                    
                    <MudSwitch Color="Color.Inherit"
                               @bind-Value="@_isDarkMode"
                               T="bool"
                               Class="ml-4"
                               ThumbIcon="@Icons.Material.Filled.Lightbulb" />
                </div>
            </MudAppBar>
            <MudDrawer Open="@_isDrawerOpened">
                <NavMenu/>
            </MudDrawer>
            <MudMainContent>
                <MudContainer Class="mt-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>
@code{
    private bool _isDrawerOpened = true;
    private bool _isDarkMode = true;

    #region Mudando o tema de acordo com as preferencias do windows
    // System Preferences Wacther
    private MudThemeProvider _mudThemeProvider = null!;

    private string version = $"v{WebConfiguration.SystemVersion}";
    /// <summary>
    /// Executa depois de todos os elementos serem renderizados na tela
    /// </summary>
    /// <param name="firstRender">Marca se é a primeira renderização</param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemPreference();
            await _mudThemeProvider.WatchSystemPreference(OnSystemPreferenceChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemPreferenceChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ToggleDrawer()
     => _isDrawerOpened = !_isDrawerOpened;
    

    #endregion
}
