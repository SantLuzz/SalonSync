@using SalonSync.Web.Components.Identity
@inherits LayoutComponentBase

<MudThemeProvider @ref="_mudThemeProvider"
                  @bind-IsDarkMode="_isDarkMode" 
                  Theme="WebConfiguration.Theme" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar>
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit" 
                               Edge="Edge.Start"
                               OnClick="ToggleDrawer" />
                Salon Sync 
                <MudSpacer />
                <MudText Typo="Typo.caption">
                    @{
                    string? companyLicense = context.User.FindFirst("ComapanyLicense") is not null
                    ? context.User.FindFirst("ComapanyLicense")?.Value
                    : "Não expira.";
                    }
                    Expira em: @companyLicense
                </MudText>
                <MudSpacer />
                <MudSpacer />
                <MudText Typo="Typo.caption">
                    @{
                        var companyName = $"Empresa: {context.User.FindFirst("CompanyName")?.Value}";
                        var companyCnpj = context.User.FindFirst("CompanyCnpj")?.Value;
                    }
                    @companyName @(string.IsNullOrWhiteSpace(companyCnpj) ? "" : $" - {companyCnpj}")
                </MudText>
                <MudSwitch 
                    Color="Color.Inherit"
                    @bind-Value="@_isDarkMode"
                    T="bool"
                    Class="ma-4"
                    ThumbIcon="@Icons.Material.Filled.Lightbulb"/>
            </MudAppBar>
            <MudDrawer Open="@_isDrawerOpened">
                <NavMenu/>
            </MudDrawer>
            <MudMainContent>
                <MudContainer Class="mt-4">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>
@code{
    private bool _isDrawerOpened = true;
    private bool _isDarkMode = true;

    #region Mudando o tema de acordo com as preferencias do windows
    // System Preferences Wacther
    private MudThemeProvider _mudThemeProvider = null!;

    /// <summary>
    /// Executa depois de todos os elementos serem renderizados na tela
    /// </summary>
    /// <param name="firstRender">Marca se é a primeira renderização</param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemPreference();
            await _mudThemeProvider.WatchSystemPreference(OnSystemPreferenceChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemPreferenceChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ToggleDrawer()
     => _isDrawerOpened = !_isDrawerOpened;
    

    #endregion
}
